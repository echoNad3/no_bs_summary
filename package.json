{
  "name": "no-bs-summary",
  "version": "0.3.1",
  "private": true,
  "description": "Blunt YouTube summaries from existing captions.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "tsx src/server.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build:pwa && wrangler deploy",
    "build:server": "tsc -p tsconfig.server.json",
    "build:pwa": "vite build --config vite.pwa.config.ts --configLoader runner",
    "build:extension": "vite build --config vite.extension.config.ts --configLoader runner",
    "assets:extension": "node scripts/generate-extension-icons.mjs",
    "assets:pwa": "node scripts/generate-pwa-icons.mjs",
    "assets": "npm run assets:pwa && npm run assets:extension",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "build": "npm run build:server && npm run build:pwa && npm run build:extension",
    "smoke:extension": "node scripts/extension-smoke.mjs",
    "smoke:a11y": "node scripts/accessibility-smoke.mjs",
    "check:bundles": "node scripts/check-bundle-size.mjs",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.pwa.json && tsc -p tsconfig.extension.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.10.1",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  }
}
