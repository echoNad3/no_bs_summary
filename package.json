{
  "name": "no-bullshit-summary-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Feasibility benchmark: can captioned YouTube videos produce blunt, useful summaries in under 15 seconds?",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "tsx src/index.ts",
    "bench:no-cache": "tsx src/index.ts --no-cache",
    "cache:clear": "tsx src/index.ts --clear-cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
