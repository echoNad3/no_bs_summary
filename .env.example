# Copy to .env. Add your keys. Never commit it.

# https://transcriptapi.com
TRANSCRIPTAPI_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite

# Request deadline in milliseconds
END_TO_END_TIMEOUT_MS=15000

# Local server
APP_HOST=127.0.0.1
APP_PORT=8787
