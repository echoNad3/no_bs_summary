# Copy this file to `.env` and fill in your real keys.
# Never commit the `.env` file.

# https://supadata.ai — dashboard shows your API key
SUPADATA_API_KEY=

# https://transcriptapi.com — dashboard shows your API key
TRANSCRIPTAPI_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which transcript provider(s) to benchmark: supadata | transcriptapi | all
TRANSCRIPT_PROVIDER=all

# Gemini model used for summaries
GEMINI_MODEL=gemini-3.1-flash-lite

# Hard time limit per video/provider run, in milliseconds (30000 = 30 seconds)
END_TO_END_TIMEOUT_MS=30000
