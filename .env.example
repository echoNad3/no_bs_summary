# Copy this file to `.env` and fill in your real keys.
# Never commit the `.env` file.

# https://transcriptapi.com - dashboard shows your API key
TRANSCRIPTAPI_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for summaries
GEMINI_MODEL=gemini-3.1-flash-lite

# Hard time limit per video run, in milliseconds (15000 = 15 seconds)
END_TO_END_TIMEOUT_MS=15000

# Delay after each measured run; keeps Gemini quota pacing out of timings
GEMINI_PACING_MS=4500

# Local MVP server. Keep the default loopback host unless you intentionally need LAN access.
APP_HOST=127.0.0.1
APP_PORT=8787
